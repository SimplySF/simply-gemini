{
  "name": "@simplysf/simply-gemini",
  "description": "Command-line interface for managing Gemini CLI skills",
  "version": "0.1.0",
  "author": "@ClayChipps",
  "homepage": "https://github.com/SimplySF/simply-gemini",
  "bugs": "https://github.com/SimplySF/simply-gemini/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimplySF/simply-gemini",
    "directory": "packages/simply-gemini"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/docs",
    "/lib",
    "/oclif.lock",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "oclif",
    "gemini",
    "gemini-cli",
    "skills",
    "simply"
  ],
  "license": "Apache-2.0",
  "exports": "./lib/index.js",
  "type": "module",
  "types": "./lib/index.d.ts",
  "oclif": {
    "additionalVersionFlags": [
      "-v"
    ],
    "additionalHelpFlags": [
      "-h"
    ],
    "bin": "simply",
    "commands": "./lib/commands",
    "devPlugins": [
      "@oclif/plugin-command-snapshot"
    ],
    "flexibleTaxonomy": true,
    "plugins": [],
    "repositoryPrefix": "<%- repo %>/blob/@simplysf/simply-gemini@<%- version %>/packages/simply-gemini/<%- commandPath %>",
    "topicSeparator": " ",
    "topics": {
      "gemini": {
        "description": "Work with the Gemini CLI."
      },
      "gemini:skills": {
        "description": "Install, uninstall, and find Gemini CLI skills."
      }
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@oclif/core": "^4.11.2",
    "@simplysf/simply-gemini-core": "workspace:^0.1.0",
    "execa": "^10.2.0"
  },
  "devDependencies": {
    "@oclif/plugin-command-snapshot": "^5.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oclif": "^4.23.0",
    "shx": "^0.4.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "wireit",
    "compile": "wireit",
    "fix-license": "eslint src test --fix --rule \"header/header: [2]\"",
    "format": "wireit",
    "lint": "wireit",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "pnpm run compile && oclif manifest",
    "readme": "oclif readme --no-aliases",
    "test": "wireit",
    "test:coverage": "wireit",
    "test:only": "wireit",
    "test:watch": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "command-snapshot",
        "compile",
        "lint"
      ]
    },
    "compile": {
      "command": "tsc -p . --pretty --incremental",
      "files": [
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": [
        "lib/**",
        "*.tsbuildinfo"
      ],
      "clean": "if-file-deleted",
      "dependencies": [
        "../simply-gemini-core:compile"
      ]
    },
    "format": {
      "command": "prettier --write \"+(src|test)/**/*.+(ts|js|json)|command-snapshot.json\"",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "command-snapshot.json",
        ".prettier*"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint src test --color --cache --cache-location .eslintcache",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "**/.eslint*",
        "**/tsconfig.json",
        "../../eslint.config.mjs",
        "../../tsconfig.json"
      ],
      "output": [],
      "dependencies": [
        "../simply-gemini-core:compile"
      ]
    },
    "test": {
      "dependencies": [
        "test:compile",
        "test:only",
        "lint"
      ]
    },
    "command-snapshot": {
      "command": "node --loader ts-node/esm --no-warnings=ExperimentalWarning \"./bin/dev.js\" snapshot:generate && prettier --write command-snapshot.json",
      "files": [
        "src/**/*.ts"
      ],
      "output": [
        "command-snapshot.json"
      ],
      "dependencies": [
        "compile"
      ]
    },
    "test:compile": {
      "command": "tsc -p \"./test\" --pretty",
      "files": [
        "test/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": [],
      "dependencies": [
        "../simply-gemini-core:compile"
      ]
    },
    "test:only": {
      "command": "vitest run --project simply-gemini",
      "env": {
        "FORCE_COLOR": "2"
      },
      "files": [
        "test/**/*.ts",
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json",
        "vitest.config.ts",
        "!*.nut.ts"
      ],
      "output": [],
      "dependencies": [
        "../simply-gemini-core:compile"
      ]
    },
    "test:coverage": {
      "command": "vitest run --coverage --project simply-gemini",
      "env": {
        "FORCE_COLOR": "2"
      },
      "dependencies": [
        "../simply-gemini-core:compile"
      ],
      "files": [
        "test/**/*.ts",
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json",
        "vitest.config.ts",
        "!*.nut.ts"
      ],
      "output": [
        "coverage/**"
      ]
    },
    "test:watch": {
      "command": "vitest watch --project simply-gemini",
      "env": {
        "FORCE_COLOR": "2"
      },
      "dependencies": [
        "../simply-gemini-core:compile"
      ],
      "service": true
    }
  }
}
